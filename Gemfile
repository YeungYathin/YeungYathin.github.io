source "https://rubygems.org"

# GitHub Pages builds this site server-side with its own pinned gem set.
# Installing the same gem locally is the only way to preview what will
# actually ship: it pins Jekyll and every plugin to the versions Pages runs.
gem "github-pages", group: :jekyll_plugins

# Ruby 3+ no longer ships webrick, which `jekyll serve` needs.
gem "webrick", "~> 1.8"
